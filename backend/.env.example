# Copy this file to .env and fill in the values. Never commit .env.

# Supabase > project page > Connect > "Transaction pooler" (URI, port 6543).
# Not the Session pooler (port 5432): it allows only 15 connections for the whole
# team and fails with "max clients reached". Replace [YOUR-PASSWORD] with the password.
# Leave empty to use a local SQLite file (sqlite:///./tranche_guard.db) for quick tests.
DATABASE_URL=postgresql://postgres.nkzfqdvhfhvtytmklenj:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# API key of the demo/simulator device (sim-001). The seed script stores its hash;
# the simulator sends it in the X-Device-Key header. Generate like JWT_SECRET.
DEVICE_API_KEY=

# Optional: Anthropic API key to reword tips in friendly French. Empty = template tips.
LLM_API_KEY=

# Enables POST /api/demo/spike (jury demo). Set to false outside the demo.
DEMO_MODE=true

# Optional: SMTP server for verification and password-reset codes.
# Empty SMTP_HOST: codes are written to the API log, and with DEMO_MODE=true
# they are also shown on screen so sign-up works in the local demo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Tranche Guard <no-reply@trancheguard.tn>

# Frontend origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
